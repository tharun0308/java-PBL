# Google OAuth2 Credentials
# Obtain these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
# Authorized JavaScript origin: http://localhost:3000, http://localhost:8080
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth2 Frontend Redirect URI
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/oauth-callback
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
